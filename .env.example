############
# Required #
############

# Put environment type here (development, staging, or production)
NODE_ENV=development

# Put Discord bot token here, you can get it from https://discord.com/developers/applications
TOKEN=

# Put the database connection URL here
# Example for SQLite:
DB=sqlite://db/data.sqlite
# Example for PostgreSQL:
# DB=postgresql://esmbot:verycoolpass100@localhost:5432/esmbot

# Put snowflake ID of bot owner here (obtainable by going into Discord settings -> Appearance and enabling Developer Mode,
# then right clicking on your profile picture and selecting Copy ID)
OWNER=

# Put default classic command prefix here
PREFIX=&

# Put default locale here (e.g. en-US, pt-BR, ru)
LOCALE=en-US

############
# Optional #
############

# Set this to true if you want the bot to stay in voice chats after music has stopped
# (you can still make the bot leave using the stop command)
STAYVC=false

# Put Klipy API key here (used for obtaining raw Klipy GIF URLs)
KLIPY=

# Put an OpenRouter API key here to enable the AI commands, leave blank to disable
# You can get one from https://openrouter.ai/settings/keys
OPENROUTER=
# Model used by the ask command, must accept image input to answer questions about images
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
# Model used by the imagine and edit commands, must accept image input for edit to work
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-4.5
# Site URL reported to OpenRouter for its rankings, defaults to https://esmbot.net
OPENROUTER_REFERER=

# Put a custom Discord REST API URL here (e.g. https://discord.com/api/v10)
REST_PROXY=
# Amount of time to wait before a REST request is timed out, defaults to 15000
REST_TIMEOUT_MS=

# Put a Sentry DSN endpoint URL here (used for error monitoring and statistics)
SENTRY_DSN=

# Put HTML help page output location here, leave blank to disable
OUTPUT=
# Put temporary media dir here (make sure it's accessible via a web server), leave blank to disable
TEMPDIR=
# Put temporary media web server domain
TMP_DOMAIN=
# Threshold where optional space saving methods will be performed
THRESHOLD=
# Port for serving cluster management endpoints and Prometheus-compatible metrics, leave blank to disable
CLUSTER_PORT=

# The media API type to be used
# Set this to `none` to process all media locally
# Set this to `ws` if you want to use the external media API script, located in dist/api/index.js
API_TYPE=none

# Put ID of server to limit owner-only commands to
ADMIN_SERVER=
